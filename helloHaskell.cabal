cabal-version: 2.2
name: helloHaskell
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-doc-files: CHANGELOG.md

common shared-settings
  ghc-options:
    "-Wall,"
    -Wno-type-defaults

  build-depends: base ^>=4.22.0.0
  default-language: GHC2024

library
  import: shared-settings
  hs-source-dirs: src
  exposed-modules:
    Chapter1
    Chapter2
    Chapter4
    Chapter5

test-suite helloHaskell-Tests
  import: shared-settings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Chapter1Spec
    Chapter2Spec
    Chapter4Spec
    Chapter5Spec

  build-depends:
    helloHaskell,
    tasty,
    tasty-hunit,
    tasty-rerun,
